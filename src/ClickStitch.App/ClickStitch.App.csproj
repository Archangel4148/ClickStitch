<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <RootNamespace>ClickStitch</RootNamespace>
    <AssemblyName>ClickStitch</AssemblyName>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationTitle>ClickStitch</ApplicationTitle>
    <Description>ClickStitch shell for Windows 11. The tryout panel is the only reason this project references Input.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClickStitch.Core\ClickStitch.Core.csproj" />
    <ProjectReference Include="..\ClickStitch.Input\ClickStitch.Input.csproj" />
    <ProjectReference Include="..\ClickStitch.Plugins.Host\ClickStitch.Plugins.Host.csproj" />
  </ItemGroup>

</Project>
