<Window x:Class="ClickStitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClickStitch"
        Width="560"
        Height="360"
        MinWidth="480"
        MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="#F6F3EE"
        Foreground="#1C2430"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="16"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Grid>
    <Border x:Name="AccentBar"
            Width="6"
            HorizontalAlignment="Left"
            Background="#B4532A" />
    <StackPanel Margin="40,36,32,32">
      <TextBlock x:Name="Heading"
                 FontSize="32"
                 FontWeight="SemiBold"
                 AutomationProperties.Name="ClickStitch" />
      <TextBlock Margin="0,8,0,0"
                 Text="Desktop macros for Windows 11." />
      <TextBlock Margin="0,24,0,0"
                 TextWrapping="Wrap"
                 Text="This build is the project foundation. Creating, recording, and running macros arrive in later phases." />
      <TextBlock x:Name="FormatText"
                 Margin="0,16,0,0"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>
