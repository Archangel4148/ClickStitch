<Window x:Class="ClickStitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClickStitch"
        Width="640"
        Height="900"
        MinWidth="520"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#F6F3EE"
        Foreground="#1C2430"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="16"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Grid>
    <Border x:Name="AccentBar"
            Width="6"
            HorizontalAlignment="Left"
            Background="#B4532A" />
    <DockPanel Margin="28,24,24,20">
      <StackPanel DockPanel.Dock="Top">
        <TextBlock x:Name="Heading"
                   FontSize="28"
                   FontWeight="SemiBold"
                   AutomationProperties.Name="ClickStitch" />
        <TextBlock Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Text="Tryout. Record and the buttons below send real input. Aim at an empty spot, not this window. Stop releases a held key. Closing the window stops the run and the recording." />
      </StackPanel>

      <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Top"
                   Margin="0,0,0,8"
                   FontWeight="SemiBold"
                   Text="Idle" />
        <TextBox x:Name="LogBox"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True"
                 MinHeight="120"
                 FontSize="14" />
      </DockPanel>

      <StackPanel Margin="0,20,0,0">
        <TextBlock Text="Pointer" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock VerticalAlignment="Center" Text="X" />
          <TextBox x:Name="XBox" Width="88" Margin="8,0,16,0" Text="40" />
          <TextBlock VerticalAlignment="Center" Text="Y" />
          <TextBox x:Name="YBox" Width="88" Margin="8,0,16,0" Text="40" />
          <TextBlock VerticalAlignment="Center" Text="Clicks" />
          <TextBox x:Name="CountBox" Width="48" Margin="8,0,0,0" Text="1" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="Move pointer" Padding="12,6" Click="Move_Click" />
          <Button Content="Click" Margin="8,0,0,0" Padding="12,6" Click="Click_Click" />
        </StackPanel>

        <TextBlock Margin="0,20,0,0" Text="Key" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock VerticalAlignment="Center" Text="Name" />
          <TextBox x:Name="KeyBox" Width="120" Margin="8,0,16,0" Text="F13" />
          <TextBlock VerticalAlignment="Center" Text="Hold ms" />
          <TextBox x:Name="HoldBox" Width="72" Margin="8,0,0,0" Text="500" />
        </StackPanel>
        <Button Content="Hold key" Margin="0,8,0,0" Padding="12,6" HorizontalAlignment="Left" Click="Hold_Click" />

        <TextBlock Margin="0,20,0,0" Text="Repeat the click" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock VerticalAlignment="Center" Text="Times" />
          <TextBox x:Name="RepeatBox" Width="48" Margin="8,0,16,0" Text="3" />
          <TextBlock VerticalAlignment="Center" Text="Gap ms" />
          <TextBox x:Name="GapBox" Width="72" Margin="8,0,0,0" Text="200" />
        </StackPanel>
        <Button Content="Repeat click" Margin="0,8,0,0" Padding="12,6" HorizontalAlignment="Left" Click="Repeat_Click" />

        <TextBlock Margin="0,20,0,0" Text="Record and play" FontWeight="SemiBold" />
        <CheckBox x:Name="MovementBox"
                  Margin="0,8,0,0"
                  Content="Include pointer movement"
                  IsChecked="True" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="Record" Padding="12,6" Click="Record_Click" />
          <Button Content="Stop recording" Margin="8,0,0,0" Padding="12,6" Click="StopRecording_Click" />
          <Button Content="Play recording" Margin="8,0,0,0" Padding="12,6" Click="Play_Click" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
          <Button Content="Pause" Padding="12,6" Click="Pause_Click" />
          <Button Content="Resume" Margin="8,0,0,0" Padding="12,6" Click="Resume_Click" />
          <Button x:Name="StopButton"
                  Content="Stop"
                  Margin="8,0,0,0"
                  Padding="16,6"
                  FontWeight="SemiBold"
                  Background="#B4532A"
                  Foreground="#FFF8F4"
                  Click="Stop_Click" />
        </StackPanel>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
