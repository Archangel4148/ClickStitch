<Window x:Class="ClickStitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ClickStitch"
        Width="448"
        SizeToContent="Height"
        MinWidth="400"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource PaperBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI Variable, Segoe UI"
        FontSize="13"
        Icon="Assets/clickstitch_icon_rounded.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        StateChanged="Window_StateChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Border x:Name="RootEdge"
          Background="{DynamicResource PaperBrush}"
          BorderBrush="{DynamicResource LineBrush}"
          BorderThickness="1">
    <DockPanel>
      <Grid DockPanel.Dock="Top" Height="40">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Width="22"
               Height="22"
               Margin="16,0,10,0"
               VerticalAlignment="Center"
               Source="Assets/clickstitch_icon_rounded.png"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Text="ClickStitch" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Style="{StaticResource CaptionButton}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Content="&#xE921;"
                  AutomationProperties.Name="Minimize"
                  Click="Minimize_Click" />
          <Button x:Name="MaxButton"
                  Style="{StaticResource CaptionButton}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  AutomationProperties.Name="Maximize"
                  Click="Max_Click">
            <TextBlock x:Name="MaxIcon" FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE922;" />
          </Button>
          <Button Style="{StaticResource CloseButton}"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Content="&#xE8BB;"
                  AutomationProperties.Name="Close"
                  Click="Close_Click" />
        </StackPanel>
      </Grid>

      <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,0,8,0">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ClickButton" Style="{StaticResource NavButton}" Click="ClickPage_Click" AutomationProperties.Name="Click">
            <AccessText Text="_Click" />
          </Button>
          <Button x:Name="MacrosButton" Margin="4,0,0,0" Style="{StaticResource NavButton}" Click="Macros_Click" AutomationProperties.Name="Macros">
            <AccessText Text="_Macros" />
          </Button>
          <Button x:Name="RecordButton" Margin="4,0,0,0" Style="{StaticResource NavButton}" Click="OpenRecord_Click" AutomationProperties.Name="Record">
            <AccessText Text="_Record" />
          </Button>
          <Button x:Name="PluginsButton" Margin="4,0,0,0" Style="{StaticResource NavButton}" Click="Plugins_Click" AutomationProperties.Name="Plugins">
            <AccessText Text="_Plugins" />
          </Button>
          <Button x:Name="SettingsButton" Margin="4,0,0,0" Style="{StaticResource NavButton}" Click="Settings_Click" AutomationProperties.Name="Settings">
            <AccessText Text="_Settings" />
          </Button>
        </StackPanel>
      </Border>

      <Border x:Name="MacroNav"
              DockPanel.Dock="Top"
              Visibility="Collapsed"
              BorderBrush="{DynamicResource LineBrush}"
              BorderThickness="0,0,0,1"
              Padding="12,6">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="LibraryButton" Style="{StaticResource NavButton}" Click="Library_Click" AutomationProperties.Name="Library">
            <AccessText Text="_Library" />
          </Button>
          <Button x:Name="EditorButton" Margin="4,0,0,0" Style="{StaticResource NavButton}" Click="Editor_Click" AutomationProperties.Name="Editor">
            <AccessText Text="_Editor" />
          </Button>
          <Button x:Name="RunButton" Margin="4,0,0,0" Style="{StaticResource NavButton}" Click="Run_Click" AutomationProperties.Name="Run">
            <AccessText Text="R_un" />
          </Button>
          <Button Margin="12,0,0,0" MinHeight="40" Padding="16,8" Click="NewMacro_Click" AutomationProperties.Name="New macro">
            <AccessText Text="New macr_o" />
          </Button>
        </StackPanel>
      </Border>

      <Border DockPanel.Dock="Bottom"
              Background="{DynamicResource CardBrush}"
              BorderBrush="{DynamicResource LineBrush}"
              BorderThickness="0,1,0,0"
              Padding="12,8">
        <DockPanel>
          <Button x:Name="StopButton"
                  DockPanel.Dock="Right"
                  MinWidth="88"
                  MinHeight="32"
                  Padding="12,4"
                  FontWeight="SemiBold"
                  Background="{DynamicResource StopBrush}"
                  Foreground="{DynamicResource StopTextBrush}"
                  BorderBrush="{DynamicResource StopBrush}"
                  AutomationProperties.Name="Stop. Ends the run and releases held keys."
                  Click="Stop_Click">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Viewbox Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE71A;" />
              </Viewbox>
              <TextBlock VerticalAlignment="Center" Text="Stop" />
            </StackPanel>
          </Button>
          <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontWeight="SemiBold" Text="Idle" />
        </DockPanel>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,16,12">
        <Grid>
          <StackPanel x:Name="ClickPage">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Button or key" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border x:Name="TargetFace"
                      Background="{DynamicResource FieldBrush}"
                      BorderBrush="{DynamicResource LineBrush}"
                      BorderThickness="1"
                      MinHeight="34"
                      Cursor="Hand"
                      MouseLeftButtonDown="TargetFace_Click">
                <DockPanel>
                  <Border DockPanel.Dock="Right"
                          Width="32"
                          IsHitTestVisible="False"
                          AutomationProperties.Name="Open the button and key list">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE70D;" />
                  </Border>
                  <TextBlock x:Name="TargetGlyph"
                             Width="16"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center"
                             FontFamily="Segoe MDL2 Assets"
                             FontSize="14"
                             Text="&#xE962;" />
                  <TextBlock x:Name="TargetLabel" Margin="8,0,0,0" VerticalAlignment="Center" Text="Left button" />
                </DockPanel>
              </Border>
              <Popup x:Name="TargetPopup"
                     PlacementTarget="{Binding ElementName=TargetFace}"
                     Placement="Bottom"
                     StaysOpen="False"
                     AllowsTransparency="True">
                <ListBox x:Name="TargetBox"
                         Width="280"
                         MaxHeight="240"
                         Background="{DynamicResource FieldBrush}"
                         Foreground="{DynamicResource InkBrush}"
                         BorderBrush="{DynamicResource LineBrush}"
                         BorderThickness="1"
                         SelectionChanged="Target_Changed">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                      <Setter Property="Padding" Value="8,4" />
                    </Style>
                  </ListBox.ItemContainerStyle>
                </ListBox>
              </Popup>
              <Button x:Name="ArmTargetButton" Grid.Column="2" Content="Press" MinWidth="76" Click="ArmTarget_Click" AutomationProperties.Name="Press a button or key to choose it" />
            </Grid>
            <TextBlock x:Name="ArmHint" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

            <TextBlock Margin="0,16,0,6" Style="{StaticResource FieldLabel}" Text="Mode" />
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="1" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="SpamMode" GroupName="ClickMode" IsChecked="True" Checked="ClickForm_Changed" Style="{StaticResource Segment}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE895;" />
                    <TextBlock VerticalAlignment="Center" Text="Spam" />
                  </StackPanel>
                </RadioButton>
                <Border Grid.Column="1" Background="{DynamicResource LineBrush}" />
                <RadioButton x:Name="HoldMode" Grid.Column="2" GroupName="ClickMode" Checked="ClickForm_Changed" Style="{StaticResource Segment}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE718;" />
                    <TextBlock VerticalAlignment="Center" Text="Hold" />
                  </StackPanel>
                </RadioButton>
              </Grid>
            </Border>

            <StackPanel x:Name="SpamOptions" Margin="0,16,0,0">
              <Grid>
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Text="Interval" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                  <TextBox x:Name="GapBox" Width="72" Text="100" />
                  <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Text="ms" />
                </StackPanel>
              </Grid>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="1" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="UntilStopBox" GroupName="ClickRepeat" Content="Until stop" IsChecked="True" Checked="ClickForm_Changed" Style="{StaticResource Segment}" />
                    <Border Grid.Column="1" Background="{DynamicResource LineBrush}" />
                    <RadioButton x:Name="CountModeBox" Grid.Column="2" GroupName="ClickRepeat" Content="Count" Checked="ClickForm_Changed" Style="{StaticResource Segment}" />
                  </Grid>
                </Border>
                <TextBox x:Name="RepeatBox" Grid.Column="2" Text="10" />
              </Grid>
              <StackPanel x:Name="ClickTypeRow" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Clicks" />
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="1" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="1" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="SingleBox" GroupName="ClickType" Content="Single" IsChecked="True" Style="{StaticResource Segment}" />
                    <Border Grid.Column="1" Background="{DynamicResource LineBrush}" />
                    <RadioButton x:Name="DoubleBox" Grid.Column="2" GroupName="ClickType" Content="Double" Style="{StaticResource Segment}" />
                    <Border Grid.Column="3" Background="{DynamicResource LineBrush}" />
                    <RadioButton x:Name="TripleBox" Grid.Column="4" GroupName="ClickType" Content="Triple" Style="{StaticResource Segment}" />
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>

            <StackPanel x:Name="PlaceRow" Margin="0,16,0,0">
              <TextBlock Style="{StaticResource FieldLabel}" Text="Where" />
              <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <RadioButton x:Name="HereBox" GroupName="ClickPlace" IsChecked="True" Checked="ClickForm_Changed" Style="{StaticResource Segment}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE962;" />
                      <TextBlock VerticalAlignment="Center" Text="Pointer" />
                    </StackPanel>
                  </RadioButton>
                  <Border Grid.Column="1" Background="{DynamicResource LineBrush}" />
                  <RadioButton x:Name="PointBox" Grid.Column="2" GroupName="ClickPlace" Checked="ClickForm_Changed" Style="{StaticResource Segment}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE707;" />
                      <TextBlock VerticalAlignment="Center" Text="Point" />
                    </StackPanel>
                  </RadioButton>
                </Grid>
              </Border>
              <StackPanel x:Name="PointFields" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                <Button x:Name="PickPointButton" Content="Pick" MinWidth="52" Margin="0,0,12,0" Click="PickPoint_Click" AutomationProperties.Name="Pick a point by clicking it" />
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Text="X" />
                <TextBox x:Name="XBox" Width="72" Margin="8,0,12,0" Text="0" />
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Text="Y" />
                <TextBox x:Name="YBox" Width="72" Margin="8,0,0,0" Text="0" />
              </StackPanel>
            </StackPanel>

            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Text="Shortcut" />
              <TextBlock x:Name="HotkeyLabel" Grid.Column="1" Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="None" />
              <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="ArmHotkeyButton" Content="Set" MinWidth="52" Click="ArmHotkey_Click" AutomationProperties.Name="Set the toggle shortcut" />
                <Button Margin="6,0,0,0" Content="Clear" MinWidth="52" Click="ClearHotkey_Click" />
              </StackPanel>
            </Grid>

            <Button Margin="0,18,0,0"
                    Style="{StaticResource AccentButton}"
                    AutomationProperties.Name="Start clicking"
                    Click="StartClick_Click">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Margin="0,1,8,0" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE768;" />
                <TextBlock VerticalAlignment="Center" Text="Start" />
              </StackPanel>
            </Button>
            <TextBlock x:Name="ClickStatus" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel x:Name="RecordPage" Visibility="Collapsed">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Record" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap"
                       Text="Record keeps clicks, keys, and the wheel. Play sends that recording as real input. Clicks on this window are left out. The take stays in memory." />
            <CheckBox x:Name="MovementBox" Margin="0,16,0,0" Content="Include pointer movement" IsChecked="True" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="Record" MinHeight="44" Padding="16,8" Click="Record_Click" />
              <Button Content="Stop recording" Margin="8,0,0,0" MinHeight="44" Padding="16,8" Click="StopRecording_Click" />
              <Button Content="Play" Margin="8,0,0,0" MinHeight="44" Padding="16,8" Click="Play_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="Pause" MinHeight="40" Padding="14,8" Click="Pause_Click" />
              <Button Content="Resume" Margin="8,0,0,0" MinHeight="40" Padding="14,8" Click="Resume_Click" />
            </StackPanel>
            <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="What happened" />
            <TextBox x:Name="LogBox"
                     Margin="0,8,0,0"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True"
                     MinHeight="160"
                     FontSize="14" />
          </StackPanel>

          <StackPanel x:Name="EditorPage" Visibility="Collapsed">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Editor" />
            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="Add actions, then save. This page does not move the pointer or press keys. Run plays a macro." />
            <TextBlock x:Name="EditorBanner" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            <StackPanel x:Name="EditorChoiceRow" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
              <Button Content="Discard" MinHeight="36" Padding="12,6" Click="EditorDiscard_Click" AutomationProperties.Name="Discard unsaved changes" />
              <Button Content="Keep editing" Margin="8,0,0,0" MinHeight="36" Padding="12,6" Click="EditorKeep_Click" />
            </StackPanel>
            <TextBlock Margin="0,16,0,0" FontSize="13" Foreground="{DynamicResource MutedBrush}" Text="Name" />
            <TextBox x:Name="EditorName" Margin="0,4,0,0" MinHeight="36" TextChanged="EditorName_Changed" />
            <TextBlock Margin="0,12,0,0" FontSize="13" Foreground="{DynamicResource MutedBrush}" Text="Description" />
            <TextBox x:Name="EditorDescription" Margin="0,4,0,0" MinHeight="72" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextChanged="EditorDescription_Changed" />
            <TextBlock x:Name="EditorProblems" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ThreadBrush}" />
            <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="Add" />
            <WrapPanel x:Name="EditorPalette" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <Button x:Name="EditorUndoButton" Content="Undo" MinHeight="36" Padding="12,6" Click="EditorUndo_Click" />
              <Button x:Name="EditorRedoButton" Content="Redo" Margin="8,0,0,0" MinHeight="36" Padding="12,6" Click="EditorRedo_Click" />
              <Button Content="Save" Margin="8,0,0,0" MinHeight="36" Padding="12,6" Click="EditorSave_Click" AutomationProperties.Name="Save macro" />
            </StackPanel>
            <TextBlock x:Name="EditorStatus" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="Actions" />
            <StackPanel x:Name="EditorSteps" Margin="0,8,0,0" />
            <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="Preview" />
            <TextBlock x:Name="EditorPreview" Margin="0,8,0,0" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel x:Name="LibraryPage" Visibility="Collapsed">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Library" />
            <TextBlock x:Name="HomeFolder" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="LibraryFolder" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="Recent" />
            <StackPanel x:Name="HomeRecent" Margin="0,8,0,0" />
            <TextBlock Margin="0,16,0,0" FontSize="13" Foreground="{DynamicResource MutedBrush}" Text="Search" />
            <TextBox x:Name="LibrarySearch" Margin="0,4,0,0" MinHeight="36" TextChanged="LibrarySearch_Changed" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <RadioButton x:Name="SortName" GroupName="LibrarySort" Content="Name" IsChecked="True" Checked="LibrarySort_Checked" />
              <RadioButton x:Name="SortNewest" Margin="16,0,0,0" GroupName="LibrarySort" Content="Newest" Checked="LibrarySort_Checked" />
            </StackPanel>
            <StackPanel x:Name="LibraryRows" Margin="0,12,0,0" />
            <TextBlock x:Name="LibraryStatus" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="LibraryConfirmText" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            <StackPanel x:Name="LibraryConfirm" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
              <Button Content="Delete" MinHeight="36" Padding="12,6" Click="LibraryDelete_Click" AutomationProperties.Name="Delete this macro" />
              <Button Content="Keep" Margin="8,0,0,0" MinHeight="36" Padding="12,6" Click="LibraryKeep_Click" />
            </StackPanel>
            <TextBlock Margin="0,16,0,0" FontSize="13" Foreground="{DynamicResource MutedBrush}" Text="Name" />
            <TextBox x:Name="LibraryName" Margin="0,4,0,0" MinHeight="36" />
            <WrapPanel Margin="0,12,0,0">
              <Button Content="Open" MinHeight="36" Padding="12,6" Margin="0,0,8,8" Click="LibraryOpen_Click" />
              <Button Content="Rename" MinHeight="36" Padding="12,6" Margin="0,0,8,8" Click="LibraryRename_Click" />
              <Button Content="Duplicate" MinHeight="36" Padding="12,6" Margin="0,0,8,8" Click="LibraryDuplicate_Click" />
              <Button Content="Delete" MinHeight="36" Padding="12,6" Margin="0,0,8,8" Click="LibraryAskDelete_Click" />
              <Button Content="Import" MinHeight="36" Padding="12,6" Margin="0,0,8,8" Click="LibraryImport_Click" />
              <Button Content="Export" MinHeight="36" Padding="12,6" Margin="0,0,8,8" Click="LibraryExport_Click" />
            </WrapPanel>
          </StackPanel>

          <StackPanel x:Name="RunPage" Visibility="Collapsed">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Run" />
            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="Run sends real clicks and keys. Aim at the place the macro expects. Stop stays at the bottom of this window." />
            <TextBlock x:Name="RunMacro" Margin="0,16,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="RunState" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="RunElapsed" Margin="0,4,0,0" />
            <TextBlock x:Name="RunAction" Margin="0,4,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Content="Run this macro" MinHeight="44" Padding="16,8" Click="RunMacro_Click" AutomationProperties.Name="Run this macro" />
              <Button Content="Pause" Margin="8,0,0,0" MinHeight="44" Padding="16,8" Click="Pause_Click" />
              <Button Content="Resume" Margin="8,0,0,0" MinHeight="44" Padding="16,8" Click="Resume_Click" />
            </StackPanel>
            <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="What happened" />
            <TextBox x:Name="RunLog" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="140" FontSize="14" />
          </StackPanel>

          <StackPanel x:Name="PluginsPage" Visibility="Collapsed">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Plugins" />
            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="A plugin is trusted code. It can do what you can do. Turning one on takes effect the next time ClickStitch starts." />
            <TextBlock x:Name="HomeFaults" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="PluginsFolder" Margin="0,8,0,0" TextWrapping="Wrap" />
            <CheckBox x:Name="PluginTrustBox" Margin="0,12,0,0" Checked="Trust_Changed" Unchecked="Trust_Changed">
              <TextBlock TextWrapping="Wrap" Text="I understand a plugin can do what I can do. I will enable only plugins I trust." />
            </CheckBox>
            <TextBlock x:Name="PluginStatus" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="Installed" />
            <StackPanel x:Name="PluginRows" Margin="0,8,0,0" />
            <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="Problems" />
            <TextBlock x:Name="PluginProblems" Margin="0,8,0,0" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Settings" />
            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="Appearance is saved on this PC. Hotkeys are not on this screen yet. Stop at the bottom still ends a run." />
            <TextBlock Margin="0,20,0,0" FontWeight="SemiBold" Text="Appearance" />
            <RadioButton x:Name="MatchWindowsBox" Margin="0,8,0,0" GroupName="Appearance" Content="Match Windows" Checked="Appearance_Checked" />
            <RadioButton x:Name="LightBox" Margin="0,8,0,0" GroupName="Appearance" Content="Light" Checked="Appearance_Checked" />
            <RadioButton x:Name="DarkBox" Margin="0,8,0,0" GroupName="Appearance" Content="Dark" Checked="Appearance_Checked" />
            <TextBlock Margin="0,20,0,0" FontWeight="SemiBold" Text="Macros" />
            <TextBlock x:Name="MacroFolder" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock Margin="0,20,0,0" FontWeight="SemiBold" Text="Plugins" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="The Plugins tab lists what is installed. This warning is the same one." />
            <CheckBox x:Name="TrustBox" Margin="0,8,0,0" Checked="Trust_Changed" Unchecked="Trust_Changed">
              <TextBlock TextWrapping="Wrap" Text="I understand a plugin can do what I can do. I will enable only plugins I trust. This takes effect the next time ClickStitch starts." />
            </CheckBox>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
